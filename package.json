{
  "name": "meetingmind",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared",
    "adapters"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@meetingmind/server\" \"npm run dev --workspace=@meetingmind/client\"",
    "start": "npm run build && npm run start --workspace=@meetingmind/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
