DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meetingmind?schema=public"

# --- LLM Provider Preference Order (comma-separated: gemini, nvidia, anthropic, openai, groq) ---
LLM_PROVIDER_ORDER="gemini,nvidia,anthropic,openai"

# --- Free Tier Key Stacking (comma-separated list of keys; auto-rotates on quota limits) ---
GEMINI_API_KEYS="your-gemini-key-1,your-gemini-key-2"
NVIDIA_API_KEYS="your-nvidia-key-1,your-nvidia-key-2"
ANTHROPIC_API_KEYS="sk-ant-key-1,sk-ant-key-2"
OPENAI_API_KEYS="sk-key-1,sk-key-2"
GROQ_API_KEYS="gsk_key1,gsk_key2"

# Single Key Fallbacks (legacy compatibility)
GEMINI_API_KEY="your-gemini-api-key"
NVIDIA_API_KEY="your-nvidia-api-key"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
JWT_SECRET="super-secret-jwt-key"
